{
  "name": "@karinjs/sqlite3",
  "version": "0.5.0",
  "description": "Distribute the node files along with the SQLite3 file in ESM format.",
  "keywords": [
    "karinjs",
    "sqlite3"
  ],
  "homepage": "https://github.com/sj817/node-sqlite3",
  "bugs": {
    "url": "https://github.com/sj817/node-sqlite3/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sj817/node-sqlite3.git",
    "directory": "esm"
  },
  "license": "MIT",
  "author": "shijin",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsdown",
    "build:package": "tsx ./scripts/packages.ts",
    "pub": "npm publish --access public",
    "sync": "curl -X PUT \"https://registry-direct.npmmirror.com/-/package/@karinjs/sqlite3/syncs\""
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@types/node": "^18.19.86",
    "tar": "^7.5.2",
    "tsdown": "^0.16.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "optionalDependencies": {
    "@karinjs/sqlite3-napi-v6-darwin-arm64": "0.5.0",
    "@karinjs/sqlite3-napi-v6-darwin-x64": "0.5.0",
    "@karinjs/sqlite3-napi-v6-linux-arm64": "0.5.0",
    "@karinjs/sqlite3-napi-v6-linux-x64": "0.5.0",
    "@karinjs/sqlite3-napi-v6-linuxmusl-arm64": "0.5.0",
    "@karinjs/sqlite3-napi-v6-linuxmusl-x64": "0.5.0",
    "@karinjs/sqlite3-napi-v6-win32-ia32": "0.5.0",
    "@karinjs/sqlite3-napi-v6-win32-x64": "0.5.0"
  }
}
