{
  "name": "sqlite3",
  "description": "Asynchronous, non-blocking SQLite3 bindings",
  "version": "6.0.2",
  "homepage": "https://github.com/sj817/node-sqlite3",
  "author": {
    "name": "Mapbox",
    "url": "https://mapbox.com/"
  },
  "binary": {
    "napi_versions": [
      6
    ]
  },
  "contributors": [
    "Daniel Lockyer <hi@daniellockyer.com>",
    "Konstantin Käfer <mail@kkaefer.com>",
    "Dane Springmeyer <dane@mapbox.com>",
    "Will White <will@mapbox.com>",
    "Orlando Vazquez <ovazquez@gmail.com>",
    "Artem Kustikov <kustikoff@gmail.com>",
    "Eric Fredricksen <efredricksen@gmail.com>",
    "John Wright <mrjjwright@gmail.com>",
    "Ryan Dahl <ry@tinyclouds.org>",
    "Tom MacWright <tom@mapbox.com>",
    "Carter Thaxton <carter.thaxton@gmail.com>",
    "Audrius Kažukauskas <audrius@neutrino.lt>",
    "Johannes Schauer <josch@pyneo.org>",
    "Nathan Rajlich <nathan@tootallnate.net>",
    "AJ ONeal <coolaj86@gmail.com>",
    "Mithgol",
    "Ben Noordhuis <ben@strongloop.com>"
  ],
  "files": [
    "binding.gyp",
    "deps/",
    "lib/*.js",
    "lib/*.d.ts",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sj817/node-sqlite3.git"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^8.0.0",
    "prebuild-install": "^7.1.3",
    "tar": "^7.5.10"
  },
  "devDependencies": {
    "eslint": "8.56.0",
    "mocha": "10.2.0",
    "prebuild": "13.0.1"
  },
  "//node-gyp-override": "prebuild@13 pins node-gyp ^10, which cannot detect Visual Studio 2026 (18.x) and blows the PowerShell stdio buffer while trying. VS 2026 support landed in node-gyp 12.1.0. node-gyp 13 would work too but requires Node >=22.22.2, which drops our Node 20 baseline.",
  "resolutions": {
    "prebuild/node-gyp": "12.x"
  },
  "overrides": {
    "prebuild": {
      "node-gyp": "12.x"
    }
  },
  "peerDependencies": {
    "node-gyp": "12.x"
  },
  "peerDependenciesMeta": {
    "node-gyp": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "node-gyp": "12.x"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "install": "prebuild-install -r napi || node-gyp rebuild",
    "prebuild": "prebuild --runtime napi --all --verbose",
    "rebuild": "node-gyp rebuild",
    "upload": "prebuild --verbose",
    "test": "node test/support/createdb.js && mocha -R spec --timeout 480000"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "sql",
    "sqlite",
    "sqlite3",
    "database"
  ],
  "main": "./lib/sqlite3",
  "types": "./lib/sqlite3.d.ts",
  "renovate": {
    "extends": [
      "@sj817:base"
    ]
  }
}